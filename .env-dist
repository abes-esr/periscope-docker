#
# Ci-dessous les variables pour configurer les conteneurs de periscope-docker
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#
######################################################
# Version de l'application periscope
######################################################
PERISCOPE_API_VERSION=develop-api
PERISCOPE_FRONT_VERSION=develop-front
PERISCOPE_BATCH_VERSION=develop-batch

######################################################
# Paramètres globaux
######################################################
MEM_LIMIT=5g
CPU_LIMIT=4

######################################################
# Paramétrage de periscope-front
######################################################
PERISCOPE_FRONT_API_BASEURL=secret
PERISCOPE_FRONT_TIMELINE_URL=secret
PERISCOPE_FRONT_APICOM_URL=secret
PERISCOPE_FRONT_HTTP_PORT=19080

######################################################
# Paramétrage de periscope-api
######################################################
PERISCOPE_API_SPRING_PROFILES_ACTIVE=dev
PERISCOPE_API_BASEXML_URL=secret
PERISCOPE_API_BASEXML_USERNAME=secret
PERISCOPE_API_BASEXML_PASSWORD=secret
PERISCOPE_API_JWT_TOKEN=secret
PERISCOPE_API_JWT_SECRET=secret
PERISCOPE_API_HTTP_PORT=19081

######################################################
# Config de SOLR
######################################################
PERISCOPE_DB_PORT=19082

######################################################
# Paramétrage de periframe
######################################################
TOKEN_GITLAB_PERIFRAME=___token_du_git_lab_de_l_abes___
PERIFRAME_HTTP_PORT=19083


